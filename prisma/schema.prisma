generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  company      String?
  password     String
  subscription String   @default("Free")
  createdAt    DateTime @default(now())

  savedTenders SavedTender[]
  alerts       TenderAlert[]
}

model Tender {
  id String @id @default(cuid())

  tenderId     String  @unique
  tenderNumber String? @unique
  gemId        Int?    @unique
  documentId   Int?

  source    String  @default("GeM")
  sourceUrl String?

  title      String
  category   String?
  department String?
  buyerName  String?

  country  String? @default("India")
  state    String?
  city     String?
  location String?

  estimatedValue String?
  emdAmount      String?
  tenderFee      String?

  quantity Int?

  publishDate DateTime?
  closingDate DateTime?
  openingDate DateTime?

  status String @default("ACTIVE")

  documentUrl   String?
  pdfDownloaded Boolean @default(false)

  // --------------------------
  // PDF Extracted Information
  // --------------------------

  ministry     String?
  organisation String?
  office       String?

  buyerEmail     String?
  grievanceEmail String?

  bidValidity    String?
  deliveryPeriod String?

  itemCategory    String?
  searchedStrings String?

  technicalSpecification String? @db.Text
  eligibilityCriteria    String? @db.Text

  bidDocumentText String? @db.Text

  pdfExtracted Boolean @default(false)
  
  extractedAt      DateTime?
  extractAttempts  Int       @default(0)
  extractError     String?   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime @default(now())

  savedBy   SavedTender[]
  documents TenderDocument[]
}

model SavedTender {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId   String
  tenderId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([userId, tenderId])
  @@index([userId])
  @@index([tenderId])
}

model TenderAlert {
  id String @id @default(cuid())

  keyword    String?
  category   String?
  department String?
  location   String?

  emailEnabled Boolean @default(true)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ImportLog {
  id         String    @id @default(cuid())
  source     String
  imported   Int       @default(0)
  updated    Int       @default(0)
  failed     Int       @default(0)
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  duration   Int?
  message    String?
  scanned    Int       @default(0)
}

model TenderDocument {
  id           String   @id
  tenderId     String

  fileName     String

  localPath    String?

  remoteUrl    String   @unique

  documentType String?

  downloadedAt DateTime?

  fileSize     Int?

  createdAt    DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}
